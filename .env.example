# ONOS REST endpoint as seen from the MCP server.
ONOS_URL=http://127.0.0.1:8181
ONOS_USER=onos
ONOS_PASSWORD=rocks
ONOS_APP_ID=org.onosproject.cli

# Optional Mininet topology control API as seen from the MCP server.
ONOS_CONTROL_URL=http://127.0.0.1:9090

# Approved, read-only scenario document catalogue.
ONOS_CONTEXT_MANIFEST=./context/manifest.json
ONOS_CONTEXT_MAX_BYTES=262144

# Optional explicit names when automatic hN/sN names are not suitable.
# ONOS_HOST_ALIASES=h5=10.10.0.5,web=10.10.0.50
# ONOS_SWITCH_ALIASES=edge=of:0000000000000005
# ONOS_WEBSITE_ALIASES=allowed.example=10.20.0.4,blocked.example=10.20.0.5

# Optional Streamable HTTP settings. Uncomment ONOS_HTTP=1 for the llama Web UI.
ONOS_HTTP=1
ONOS_HTTP_HOST=127.0.0.1
ONOS_HTTP_PORT=8000
ONOS_HTTP_PATH=/mcp
ONOS_CORS_ORIGINS=*
